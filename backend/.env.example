# SECRET_KEY=your-secret-key
# DEBUG=True

# # Database Settings (Local)
# DB_NAME=upha_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Production Database (Render/Hostinger)
# Set this to the "Internal Database URL" on Render dashboard.
# (If DATABASE_URL is provided, the DB_NAME/DB_USER settings above are ignored)
DATABASE_URL=

# Public URL of the backend server (used to build media file URLs in production)
# On Hostinger: BACKEND_URL=https://upha.in
# On local dev: leave empty (request.build_absolute_uri is used as fallback)
BACKEND_URL=

# URL of the frontend (used for CORS and CSRF trusted origins)
FRONTEND_URL=https://upha.in
